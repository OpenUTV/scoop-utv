{
    "version": "26.5",
    "description": "Compiled multimedia and VFX dependency toolchain (FFmpeg, Qt6, OpenEXR, OCIO, OIIO) for OpenUTV",
    "homepage": "https://github.com/OpenUTV/utv-dependencies",
    "license": "Apache-2.0",
    "depends": "lessmsi",
    "architecture": {
        "64bit": {
            "url": "https://github.com/OpenUTV/utv-dependencies/releases/download/v26.5/OpenUTVDeps-26.5-win64.msi",
            "hash": "2939e02f50d9c9877ed4615d9be35679491f37dfbd483fc7e793d71a0d365737"
        }
    },
    "installer": {
        "script": [
            "lessmsi x \"$dir\\OpenUTVDeps-26.5-win64.msi\" \"$dir\\unpacked\"",
            "Get-ChildItem \"$dir\\unpacked\\SourceDir\\OpenUTVDeps*\" | Copy-Item -Destination \"$dir\" -Recurse -Force",
            "Remove-Item -Recurse -Force \"$dir\\unpacked\", \"$dir\\OpenUTVDeps-26.5-win64.msi\""
        ]
    },
    "env_add_path": "bin",
    "env_set": {
        "OPENUTV_DEPS_ROOT": "$dir"
    },
    "checkver": {
        "github": "https://github.com/OpenUTV/utv-dependencies",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/OpenUTV/utv-dependencies/releases/download/v$version/OpenUTVDeps-$version-win64.msi"
            }
        }
    }
}
